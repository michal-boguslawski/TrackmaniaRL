# Local MLflow server configuration, sourced by scripts/mlflow_server.sh.
# Real environment variables take precedence over anything set here.
#
# Both lists must repeat the port: the server compares the full Host header, so
# "myhost" never matches and "myhost:5000" does. Never use '*' here:
#   - allowed-hosts '*' disables DNS-rebinding protection outright.
#   - cors-allowed-origins '*' makes the server turn off credentialed CORS,
#     which breaks the UI's `credentials: include' fetches.
#
# Setting these lists REPLACES MLflow's own defaults rather than extending
# them, so every host you actually browse from has to be listed here. Keep
# 127.0.0.1:5000 in both: the default MLFLOW_HOST is 0.0.0.0 but the port the
# README tells you to open on this machine is 127.0.0.1:5000, and without the
# entry every API call answers 403 "Invalid Host header".
#
# 212.180.148.200 is this workstation's public IP as of 2026-10-04. Most home
# connections are behind CGNAT with a dynamic address, so re-check it whenever
# the UI stops loading: in PowerShell,
#   (Invoke-RestMethod https://api.ipify.org)
# then replace it in both lists and run: scripts/mlflow_server.sh restart
MLFLOW_ALLOWED_HOSTS="localhost:5000,localhost:5001,127.0.0.1:5000,127.0.0.1:5001,172.17.0.3:5000,212.180.148.200:5000"
MLFLOW_CORS_ALLOWED_ORIGINS="http://localhost:5000,http://localhost:5001,http://127.0.0.1:5000,http://127.0.0.1:5001,http://172.17.0.3:5000,http://212.180.148.200:5000"