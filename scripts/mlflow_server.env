# Safe defaults for scripts/mlflow_server.sh.
# This tracked file intentionally contains no workstation-specific addresses.
# Environment variables set by the caller take precedence over these defaults.

# Bind locally by default: the MLflow UI has no authentication. Use an SSH
# tunnel for remote access instead of exposing this port to the public internet.
: "${MLFLOW_HOST:=127.0.0.1}"

# Leave these unset/empty to use MLflow's built-in localhost host and CORS
# defaults. If you need custom entries, supply them through the environment.
: "${MLFLOW_ALLOWED_HOSTS:=}"
: "${MLFLOW_CORS_ALLOWED_ORIGINS:=}"
