# Normalize line endings in the repository to LF.
* text=auto eol=lf

# Windows scripts must keep CRLF to run on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.pt binary
*.pth binary
*.db binary
